PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cs445_db?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT & Security (Thay bằng chuỗi ngẫu nhiên bảo mật ở môi trường production)
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars_dev"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars_dev"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECURE=false

# HTTPS config (Optional for local dev - đặt true và trỏ file cert để bật HTTPS)
HTTPS_ENABLED=false
SSL_KEY_PATH=""
SSL_CERT_PATH=""
